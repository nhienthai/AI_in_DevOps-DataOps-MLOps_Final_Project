# Copy to .env and adjust. Never commit .env.
SENTIMENT_LOG_LEVEL=INFO
SENTIMENT_MLFLOW_TRACKING_URI=http://mlflow:5000
SENTIMENT_MAX_BATCH_SIZE=64
SENTIMENT_MAX_REQUEST_BODY_BYTES=1000000
SENTIMENT_MAX_CONCURRENT_INFERENCES=2
SENTIMENT_INFERENCE_TIMEOUT_SECONDS=30
SENTIMENT_QUEUE_TIMEOUT_SECONDS=1
# stub    deterministic hash, no model files needed
# local   the fine-tuned XLM-R in SENTIMENT_LOCAL_MODEL_DIR
#         (run: python scripts/setup_local_model.py)
# registry the model promoted to Production in MLflow
SENTIMENT_PREDICTOR_BACKEND=stub
SENTIMENT_LOCAL_MODEL_DIR=artifacts/xlm-roberta
SENTIMENT_MODEL_DATASET_NAME=tridm/UIT-VSFC
# Required only to enable POST /reload. Generate a long random value.
SENTIMENT_RELOAD_TOKEN=
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-this-before-deployment
POSTGRES_DB=mlflow
GRAFANA_ADMIN_PASSWORD=change-this-before-deployment
