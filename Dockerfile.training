# syntax=docker/dockerfile:1

FROM python:3.11-slim-bookworm@sha256:d29f48a31a8b408ed19272ca1e7b10ebae13b240a27e862d3d4217c528e2e0c3

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-serving.txt requirements-training.txt pyproject.toml ./
RUN pip install --upgrade pip==24.3.1 \
    && pip install torch==2.6.0 --index-url https://download.pytorch.org/whl/cpu \
    && pip install --requirement requirements-training.txt

COPY src ./src
COPY scripts ./scripts
RUN pip install --no-deps .

RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid app --create-home app \
    && mkdir -p /app/artifacts /cache/huggingface \
    && chown -R 1000:1000 /app /cache

USER 1000:1000

ENTRYPOINT ["python", "scripts/train_model.py"]
CMD ["--model-type", "baseline"]
